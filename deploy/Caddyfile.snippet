# Caddy site block for guess-flag.mohamedmelekchtourou.com.
#
# Append this to /etc/caddy/Caddyfile (or include it from there) and run:
#   sudo caddy reload --config /etc/caddy/Caddyfile
#
# Caddy handles WebSocket upgrade automatically with `reverse_proxy`,
# so Socket.IO works without any extra config.

guess-flag.mohamedmelekchtourou.com {
  reverse_proxy localhost:3100

  encode gzip zstd

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options    "nosniff"
    Referrer-Policy           "strict-origin-when-cross-origin"
    X-Frame-Options           "SAMEORIGIN"
    -Server
  }

  # Logs go to systemd journal by default — visible via:
  #   sudo journalctl -u caddy -f | grep guess-flag
  # Avoid `log { output file ... }` unless you've pre-touched the file
  # with caddy:caddy ownership; otherwise reload silently fails to apply.
}
