# nginx site config for guess-flag.mohamedmelekchtourou.com.
#
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/guess-flag.conf
#   sudo ln -s /etc/nginx/sites-available/guess-flag.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then issue HTTPS with certbot (once DNS resolves):
#   sudo certbot --nginx -d guess-flag.mohamedmelekchtourou.com
#
# certbot will rewrite the listen directives below to add TLS automatically.

server {
    listen 80;
    listen [::]:80;
    server_name guess-flag.mohamedmelekchtourou.com;

    # Reasonable client body size cap (the app sends tiny JSON, but be safe).
    client_max_body_size 1m;

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # WebSocket upgrade — REQUIRED for Socket.IO to use the websocket
        # transport instead of falling back to long-polling.
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";

        # Forward the real client info so logs and rate-limits work right.
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Long timeouts so idle WebSocket connections aren't cut.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
